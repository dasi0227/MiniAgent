<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dasi.infrastructure.persistent.dao.IAiRepoDao">

    <resultMap id="dataMap" type="com.dasi.infrastructure.persistent.po.AiRepo">
        <id column="id" property="id"/>
        <result column="repo_id" property="repoId"/>
        <result column="user_id" property="userId"/>
        <result column="agent_id" property="agentId"/>
        <result column="template_id" property="templateId"/>
        <result column="repo_type" property="repoType"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="listByUserId" resultMap="dataMap">
        SELECT id,
               repo_id,
               user_id,
               agent_id,
               template_id,
               repo_type,
               create_time,
               update_time
        FROM ai_repo
        WHERE user_id = #{userId}
        ORDER BY update_time DESC, id DESC
    </select>

    <select id="queryByUserIdAndAgentIdAndRepoType" resultMap="dataMap">
        SELECT id,
               repo_id,
               user_id,
               agent_id,
               template_id,
               repo_type,
               create_time,
               update_time
        FROM ai_repo
        WHERE user_id = #{userId}
          AND agent_id = #{agentId}
          AND repo_type = #{repoType}
        LIMIT 1
    </select>

    <select id="queryByUserIdAndTemplateIdAndRepoType" resultMap="dataMap">
        SELECT id,
               repo_id,
               user_id,
               agent_id,
               template_id,
               repo_type,
               create_time,
               update_time
        FROM ai_repo
        WHERE user_id = #{userId}
          AND template_id = #{templateId}
          AND repo_type = #{repoType}
        LIMIT 1
    </select>

    <select id="queryForkedByUserIdAndTemplateIdList" resultType="java.lang.String">
        SELECT template_id
        FROM ai_repo
        WHERE user_id = #{userId}
        AND repo_type = 'fork'
        AND template_id IN
        <foreach collection="templateIdList" item="templateId" open="(" separator="," close=")">
            #{templateId}
        </foreach>
    </select>

    <insert id="insert" parameterType="com.dasi.infrastructure.persistent.po.AiRepo">
        INSERT INTO ai_repo (repo_id,
                             user_id,
                             agent_id,
                             template_id,
                             repo_type)
        VALUES (#{repoId},
                #{userId},
                #{agentId},
                #{templateId},
                #{repoType})
    </insert>

    <update id="update" parameterType="com.dasi.infrastructure.persistent.po.AiRepo">
        UPDATE ai_repo
        <set>
            <if test="repoId != null">repo_id = #{repoId},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="agentId != null">agent_id = #{agentId},</if>
            <if test="templateId != null">template_id = #{templateId},</if>
            <if test="repoType != null">repo_type = #{repoType},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteByAgentId">
        DELETE
        FROM ai_repo
        WHERE agent_id = #{agentId}
    </delete>

    <delete id="deleteByTemplateId">
        DELETE
        FROM ai_repo
        WHERE template_id = #{templateId}
    </delete>

    <delete id="deleteByUserIdAndTemplateIdAndRepoType">
        DELETE
        FROM ai_repo
        WHERE user_id = #{userId}
          AND template_id = #{templateId}
          AND repo_type = #{repoType}
    </delete>

</mapper>
