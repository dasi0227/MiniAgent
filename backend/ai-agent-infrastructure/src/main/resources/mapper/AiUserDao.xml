<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dasi.infrastructure.persistent.dao.IAiUserDao">

    <resultMap id="dataMap" type="com.dasi.infrastructure.persistent.po.AiUser">
        <id column="id" property="id"/>
        <result column="user_name" property="userName"/>
        <result column="password" property="password"/>
        <result column="user_role" property="userRole"/>
        <result column="user_avatar" property="userAvatar"/>
        <result column="user_status" property="userStatus"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="queryByUserName" parameterType="string" resultMap="dataMap">
        SELECT id, user_name, password, user_role, user_avatar, user_status, create_time, update_time
        FROM ai_user
        WHERE user_name = #{userName}
        LIMIT 1
    </select>

    <select id="page" resultMap="dataMap">
        SELECT id,
        user_name,
        password,
        user_role,
        user_avatar,
        user_status,
        create_time,
        update_time
        FROM ai_user
        <where>
            <if test="userName != null and userName != ''">
                AND user_name LIKE CONCAT('%', #{userName}, '%')
            </if>
            <if test="userRole != null and userRole != ''">
                AND user_role = #{userRole}
            </if>
        </where>
        ORDER BY update_time DESC, id DESC
        <if test="offset != null and size != null">
            LIMIT #{offset}, #{size}
        </if>
    </select>

    <select id="count" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM ai_user
        <where>
            <if test="userName != null and userName != ''">
                AND user_name LIKE CONCAT('%', #{userName}, '%')
            </if>
            <if test="userRole != null and userRole != ''">
                AND user_role = #{userRole}
            </if>
        </where>
    </select>

    <select id="countAll" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM ai_user
    </select>

    <select id="queryById" resultMap="dataMap">
        SELECT id,
               user_name,
               password,
               user_role,
               user_avatar,
               user_status,
               create_time,
               update_time
        FROM ai_user
        WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.dasi.infrastructure.persistent.po.AiUser" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ai_user (user_name,
                            password,
                            user_role,
                            user_avatar,
                            user_status)
        VALUES (#{userName},
                #{password},
                #{userRole},
                #{userAvatar},
                #{userStatus})
    </insert>

    <update id="update" parameterType="com.dasi.infrastructure.persistent.po.AiUser">
        UPDATE ai_user
        <set>
            <if test="userName != null">user_name = #{userName},</if>
            <if test="password != null">password = #{password},</if>
            <if test="userRole != null">user_role = #{userRole},</if>
            <if test="userAvatar != null">user_avatar = #{userAvatar},</if>
            <if test="userStatus != null">user_status = #{userStatus},</if>
        </set>
        WHERE id = #{id}
    </update>

    <update id="toggle">
        UPDATE ai_user
        SET user_status = #{status}
        WHERE id = #{id}
    </update>

    <delete id="delete">
        DELETE
        FROM ai_user
        WHERE id = #{id}
    </delete>
</mapper>
